# build26-repo-template

Template files will not be tracked by git.
*.bak
*.tmp

# Source materials folder — contents excluded, README tracked
_remove-before-publish/*
!_remove-before-publish/README.md

# OS files
.DS_Store
Thumbs.db

# IDE files (except .vscode/mcp.json which we want)
.idea/
*.swp
*.swo

# Environment files with secrets
.env
.env.local
.env.*.local

# Python build artifacts
__pycache__/
*.pyc

# Local-only validation / change-tracking log (not for publication)
change-recommendation.md

# Walkthrough Step 1 checkpoint outputs (agent-generated, local review only)
iteration-02-output.md
iteration-03-output.md
iteration-04-output.md

# Local validation findings reports (timestamped, not for publication)
findings-*.md

# Walkthrough Step 5 run logs (Tee-Object output, local only)
iteration-*-step5-*.log
iteration-01-naive-*.log
*.log

# Dependencies (if applicable)
node_modules/
__pycache__/
*.pyc
.venv/
