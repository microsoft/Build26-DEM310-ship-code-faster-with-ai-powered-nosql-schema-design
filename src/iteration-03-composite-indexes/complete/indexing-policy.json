{
  "_comment": "Iteration 3 merged indexing policies. Source of truth: iteration-03-output.md. Each container keeps the iter-2 baseline (includedPaths, excludedPaths, indexingMode, automatic) verbatim and adds composite indexes per iter-3.",
  "CustomerOrders": {
    "indexingMode": "consistent",
    "automatic": true,
    "includedPaths": [
      { "path": "/customerId/?" },
      { "path": "/type/?" },
      { "path": "/orderDate/?" },
      { "path": "/status/?" },
      { "path": "/categoryId/?" },
      { "path": "/price/?" },
      { "path": "/rating/?" }
    ],
    "excludedPaths": [
      { "path": "/*" },
      { "path": "/items/*" },
      { "path": "/\"_etag\"/?" }
    ],
    "compositeIndexes": [
      [
        { "path": "/type",      "order": "ascending"  },
        { "path": "/orderDate", "order": "descending" }
      ],
      [
        { "path": "/type",      "order": "ascending"  },
        { "path": "/status",    "order": "ascending"  },
        { "path": "/orderDate", "order": "descending" }
      ]
    ]
  },
  "Products": {
    "indexingMode": "consistent",
    "automatic": true,
    "includedPaths": [
      { "path": "/customerId/?" },
      { "path": "/type/?" },
      { "path": "/orderDate/?" },
      { "path": "/status/?" },
      { "path": "/categoryId/?" },
      { "path": "/price/?" },
      { "path": "/rating/?" }
    ],
    "excludedPaths": [
      { "path": "/*" },
      { "path": "/items/*" },
      { "path": "/\"_etag\"/?" }
    ],
    "compositeIndexes": [
      [
        { "path": "/rating", "order": "descending" },
        { "path": "/price",  "order": "ascending"  }
      ]
    ]
  }
}
